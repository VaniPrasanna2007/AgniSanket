# NASA FIRMS API MAP_KEY (Free from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# Google Earth Engine Service Account Credentials Path or Json
EE_SERVICE_ACCOUNT=your_service_account@project.iam.gserviceaccount.com
EE_KEY_FILE=path/to/gee_key.json

# Database Configuration (PostgreSQL/PostGIS or SQLite fallback)
# DB_URL=postgresql://postgres:postgres@localhost:5432/sih_thermal_db
DB_URL=sqlite:///./sih_thermal.db

# SMTP Configuration for Email Alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT=alerts@securitydomain.gov.in

# Regional Bounding Box (Default: India - [min_lon, min_lat, max_lon, max_lat])
BBOX=68.7,8.0,97.25,35.5
